# Algebraeon interoperability checks written directly in Koto.
# Run with: `cargo run -- --tests tests/koto/algebraeon_tests.koto`

write = |s| io.stdout().write(s)
from algebraeon import NN, ZZ, Q

@post_test = ||
  print 'ok'

@test nn_tests = ||
  write 'Testing NN \t'
  assert_eq NN(5).factorial(), NN(120)
  assert_eq NN(5) - NN(3), NN(2)

  assert NN(16).is_square()
  assert not NN(18).is_square()
  assert_eq NN(17).sqrt_floor(), NN(4)
  assert_eq NN(17).sqrt_ceil(), NN(5)

  a = NN(5)
  a += NN(1)
  a *= NN(2)
  assert_eq a, NN(12)

@test zz_tests = ||
  write 'Testing ZZ \t'
  assert_eq ZZ(-9).abs(), NN(9)
  assert ZZ(9).is_square()
  assert not ZZ(10).is_square()

  assert_eq ZZ(5) + ZZ(-3), ZZ(2)
  assert_eq ZZ(5) + NN(3), ZZ(8)
  assert_eq ZZ(7) + 5, ZZ(12)
  assert_eq ZZ(4) * ZZ(-2), ZZ(-8)

  a = ZZ(5)
  a += ZZ(1)
  a += 1
  a += NN(2)
  a *= NN(3)
  a *= 2
  assert_eq a, ZZ(54)

@test numtheory_tests = ||
  write 'Testing numtheory \t'

  # NN.primes: first 10 primes as an iterator
  primes10 = NN.primes().take(10).to_list()
  assert_eq primes10, [NN(2), NN(3), NN(5), NN(7), NN(11), NN(13), NN(17), NN(19), NN(23), NN(29)]

  # divisors
  assert_eq NN(12).divisors(), [NN(1), NN(2), NN(3), NN(4), NN(6), NN(12)]
  assert_eq NN(1).divisors(), [NN(1)]

  # euler_totient
  assert_eq NN(10).euler_totient(), NN(4)
  assert_eq NN(1).euler_totient(), NN(1)
  assert_eq NN(12).euler_totient(), NN(4)

  # is_squarefree
  assert not NN(12).is_squarefree()
  assert NN(10).is_squarefree()
  assert NN(1).is_squarefree()

  # is_power_test
  assert_eq NN(8).is_power_test(), (true, NN(2), NN(3))
  assert_eq NN(6).is_power_test(), (false, null, null)

  # primality_test
  assert_eq NN(17).primality_test(), 'prime'
  assert_eq NN(12).primality_test(), 'composite'
  assert_eq NN(1).primality_test(), 'composite'

  # ZZ::factor: negative integer, unit -1 ignored
  assert_eq ZZ(-12).factor(), [(ZZ(2), NN(2)), (ZZ(3), NN(1))]
  assert_eq ZZ(12).factor(), [(ZZ(2), NN(2)), (ZZ(3), NN(1))]

  # ZZ::divmod / div_floor / mod
  assert_eq ZZ(-7).divmod(ZZ(3)), (ZZ(-3), ZZ(2))
  assert_eq ZZ(-7).div_floor(ZZ(3)), ZZ(-3)
  assert_eq ZZ(-7).mod(ZZ(3)), ZZ(2)
  assert_eq ZZ(13).div_floor(ZZ(5)), ZZ(2)
  assert_eq ZZ(13).mod(ZZ(5)), ZZ(3)
  assert_eq ZZ(-13).div_floor(ZZ(5)), ZZ(-3)
  assert_eq ZZ(-13).mod(ZZ(5)), ZZ(2)
  assert_eq ZZ(4).mod(ZZ(3)), ZZ(1)
  assert_eq ZZ(-4).mod(ZZ(3)), ZZ(2)


@test q_tests = ||
  write 'Testing Q \t'

  # Constructor i reduccio
  assert_eq Q(6, 4), Q(3, 2)
  assert_eq Q(-2, -4), Q(1, 2)
  assert_eq Q(0, 5), Q(0, 1)
  assert_eq Q(NN(1), NN(2)), Q(1, 2)
  assert_eq Q(ZZ(-1), ZZ(2)), Q(-1, 2)
  assert_eq Q(Q(1, 2)), Q(1, 2)
  assert_eq Q(0.5), Q(1, 2)
  assert_eq Q(2), Q(2, 1)

  # Aritmetica amb Q, NN, ZZ i Number
  assert_eq Q(1, 2) + Q(1, 3), Q(5, 6)
  assert_eq Q(1, 2) - Q(1, 4), Q(1, 4)
  assert_eq Q(2, 3) * Q(3, 4), Q(1, 2)
  assert_eq Q(1, 2) / Q(3, 4), Q(2, 3)
  assert_eq Q(1, 2) + 1, Q(3, 2)
  assert_eq Q(1, 2) + NN(1), Q(3, 2)
  assert_eq Q(1, 2) + ZZ(1), Q(3, 2)
  assert_eq Q(1, 2) * 4, Q(2)
  assert_eq Q(1, 2) / ZZ(2), Q(1, 4)
  assert_eq -Q(1, 2), Q(-1, 2)

  # Assignacio += -= *= /=
  a = Q(1, 2)
  a += Q(1, 4)
  a *= 2
  a -= NN(1)
  a /= ZZ(4)
  assert_eq a, Q(1, 8)

  # Comparacions (amb Q i Number)
  assert Q(1, 2) < Q(3, 4)
  assert Q(3, 4) > Q(1, 2)
  assert Q(1, 2) <= Q(1, 2)
  assert Q(1, 2) >= Q(1, 2)
  assert Q(1, 2) != Q(2, 3)
  assert_eq Q(1, 2) == 0.5, true
  assert Q(1, 2) < 1
  assert Q(3, 2) > 1.25

  # Metodes num/den/is_integer/is_square/sqrt_if_square/height/to_float
  assert_eq Q(3, 2).num(), ZZ(3)
  assert_eq Q(-3, 2).num(), ZZ(-3)
  assert_eq Q(3, 2).den(), NN(2)
  assert_eq Q(3).den(), NN(1)
  assert Q(4, 2).is_integer()
  assert not Q(3, 2).is_integer()
  assert Q(4, 9).is_square()
  assert not Q(2, 3).is_square()
  assert_eq Q(4, 9).sqrt_if_square(), Q(2, 3)
  assert_eq Q(2, 3).sqrt_if_square(), null
  assert_eq Q(3, 2).height(), NN(3)
  assert_eq Q(-2, 5).height(), NN(5)
  assert_eq Q(3, 2).to_float(), 1.5
  assert_eq Q(-7, 4).to_float(), -1.75

  # Conversions Q -> ZZ / NN
  assert_eq Q(3).to_zz(), ZZ(3)
  assert_eq Q(4, 2).to_zz(), ZZ(2)
  assert_eq Q(4, 2).to_nn(), NN(2)
  assert_eq Q(0).to_nn(), NN(0)

  # Display: fraccio reduida num/den, i nomes num si den == 1
  assert_eq '{Q(6, 4)}', '3/2'
  assert_eq '{Q(-1, 2)}', '-1/2'
  assert_eq '{Q(3)}', '3'
  assert_eq '{Q(0, 5)}', '0'

  # Errors: denominador zero i divisio per zero
  caught = try
    Q(1, 0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Q(1, 2) / 0
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Q(1, 2) / Q(0, 3)
  catch e
    'caught'
  assert_eq caught, 'caught'


@main = ||
  print 'Algebraeon Koto tests passed'
