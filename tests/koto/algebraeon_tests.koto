# Algebraeon interoperability checks written directly in Koto.
# Run with: `cargo run -- --tests tests/koto/algebraeon_tests.koto`

write = |s| io.stdout().write(s)
from algebraeon import NN, ZZ, Q, Mat, Poly, Quat, Alg, Ideal, ZZn, FF, CF, legendre, jacobi, kronecker, eulers_constant

@post_test = ||
  print 'ok'

@test nn_tests = ||
  write 'Testing NN \t'
  assert_eq NN(5).factorial(), NN(120)
  assert_eq NN(5) - NN(3), NN(2)

  assert NN(16).is_square()
  assert not NN(18).is_square()
  assert_eq NN(17).sqrt_floor(), NN(4)
  assert_eq NN(17).sqrt_ceil(), NN(5)

  a = NN(5)
  a += NN(1)
  a *= NN(2)
  assert_eq a, NN(12)

@test zz_tests = ||
  write 'Testing ZZ \t'
  assert_eq ZZ(-9).abs(), NN(9)
  assert ZZ(9).is_square()
  assert not ZZ(10).is_square()

  assert_eq ZZ(5) + ZZ(-3), ZZ(2)
  assert_eq ZZ(5) + NN(3), ZZ(8)
  assert_eq ZZ(7) + 5, ZZ(12)
  assert_eq ZZ(4) * ZZ(-2), ZZ(-8)

  a = ZZ(5)
  a += ZZ(1)
  a += 1
  a += NN(2)
  a *= NN(3)
  a *= 2
  assert_eq a, ZZ(54)

@test numtheory_tests = ||
  write 'Testing numtheory \t'

  # NN.primes: first 10 primes as an iterator
  primes10 = NN.primes().take(10).to_list()
  assert_eq primes10, [NN(2), NN(3), NN(5), NN(7), NN(11), NN(13), NN(17), NN(19), NN(23), NN(29)]

  # divisors
  assert_eq NN(12).divisors(), [NN(1), NN(2), NN(3), NN(4), NN(6), NN(12)]
  assert_eq NN(1).divisors(), [NN(1)]

  # euler_totient
  assert_eq NN(10).euler_totient(), NN(4)
  assert_eq NN(1).euler_totient(), NN(1)
  assert_eq NN(12).euler_totient(), NN(4)

  # is_squarefree
  assert not NN(12).is_squarefree()
  assert NN(10).is_squarefree()
  assert NN(1).is_squarefree()

  # is_power_test
  assert_eq NN(8).is_power_test(), (true, NN(2), NN(3))
  assert_eq NN(6).is_power_test(), (false, null, null)

  # primality_test
  assert_eq NN(17).primality_test(), 'prime'
  assert_eq NN(12).primality_test(), 'composite'
  assert_eq NN(1).primality_test(), 'composite'

  # ZZ::factor: negative integer, unit -1 ignored
  assert_eq ZZ(-12).factor(), [(ZZ(2), NN(2)), (ZZ(3), NN(1))]
  assert_eq ZZ(12).factor(), [(ZZ(2), NN(2)), (ZZ(3), NN(1))]

  # ZZ::divmod / div_floor / mod
  assert_eq ZZ(-7).divmod(ZZ(3)), (ZZ(-3), ZZ(2))
  assert_eq ZZ(-7).div_floor(ZZ(3)), ZZ(-3)
  assert_eq ZZ(-7).mod(ZZ(3)), ZZ(2)
  assert_eq ZZ(13).div_floor(ZZ(5)), ZZ(2)
  assert_eq ZZ(13).mod(ZZ(5)), ZZ(3)
  assert_eq ZZ(-13).div_floor(ZZ(5)), ZZ(-3)
  assert_eq ZZ(-13).mod(ZZ(5)), ZZ(2)
  assert_eq ZZ(4).mod(ZZ(3)), ZZ(1)
  assert_eq ZZ(-4).mod(ZZ(3)), ZZ(2)


@test q_tests = ||
  write 'Testing Q \t'

  # Constructor i reduccio
  assert_eq Q(6, 4), Q(3, 2)
  assert_eq Q(-2, -4), Q(1, 2)
  assert_eq Q(0, 5), Q(0, 1)
  assert_eq Q(NN(1), NN(2)), Q(1, 2)
  assert_eq Q(ZZ(-1), ZZ(2)), Q(-1, 2)
  assert_eq Q(Q(1, 2)), Q(1, 2)
  assert_eq Q(0.5), Q(1, 2)
  assert_eq Q(2), Q(2, 1)

  # Aritmetica amb Q, NN, ZZ i Number
  assert_eq Q(1, 2) + Q(1, 3), Q(5, 6)
  assert_eq Q(1, 2) - Q(1, 4), Q(1, 4)
  assert_eq Q(2, 3) * Q(3, 4), Q(1, 2)
  assert_eq Q(1, 2) / Q(3, 4), Q(2, 3)
  assert_eq Q(1, 2) + 1, Q(3, 2)
  assert_eq Q(1, 2) + NN(1), Q(3, 2)
  assert_eq Q(1, 2) + ZZ(1), Q(3, 2)
  assert_eq Q(1, 2) * 4, Q(2)
  assert_eq Q(1, 2) / ZZ(2), Q(1, 4)
  assert_eq -Q(1, 2), Q(-1, 2)

  # Assignacio += -= *= /=
  a = Q(1, 2)
  a += Q(1, 4)
  a *= 2
  a -= NN(1)
  a /= ZZ(4)
  assert_eq a, Q(1, 8)

  # Comparacions (amb Q i Number)
  assert Q(1, 2) < Q(3, 4)
  assert Q(3, 4) > Q(1, 2)
  assert Q(1, 2) <= Q(1, 2)
  assert Q(1, 2) >= Q(1, 2)
  assert Q(1, 2) != Q(2, 3)
  assert_eq Q(1, 2) == 0.5, true
  assert Q(1, 2) < 1
  assert Q(3, 2) > 1.25

  # Metodes num/den/is_integer/is_square/sqrt_if_square/height/to_float
  assert_eq Q(3, 2).num(), ZZ(3)
  assert_eq Q(-3, 2).num(), ZZ(-3)
  assert_eq Q(3, 2).den(), NN(2)
  assert_eq Q(3).den(), NN(1)
  assert Q(4, 2).is_integer()
  assert not Q(3, 2).is_integer()
  assert Q(4, 9).is_square()
  assert not Q(2, 3).is_square()
  assert_eq Q(4, 9).sqrt_if_square(), Q(2, 3)
  assert_eq Q(2, 3).sqrt_if_square(), null
  assert_eq Q(3, 2).height(), NN(3)
  assert_eq Q(-2, 5).height(), NN(5)
  assert_eq Q(3, 2).to_float(), 1.5
  assert_eq Q(-7, 4).to_float(), -1.75

  # Conversions Q -> ZZ / NN
  assert_eq Q(3).to_zz(), ZZ(3)
  assert_eq Q(4, 2).to_zz(), ZZ(2)
  assert_eq Q(4, 2).to_nn(), NN(2)
  assert_eq Q(0).to_nn(), NN(0)

  # Display: fraccio reduida num/den, i nomes num si den == 1
  assert_eq '{Q(6, 4)}', '3/2'
  assert_eq '{Q(-1, 2)}', '-1/2'
  assert_eq '{Q(3)}', '3'
  assert_eq '{Q(0, 5)}', '0'

  # Errors: denominador zero i divisio per zero
  caught = try
    Q(1, 0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Q(1, 2) / 0
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Q(1, 2) / Q(0, 3)
  catch e
    'caught'
  assert_eq caught, 'caught'


@test poly_tests = ||
  write 'Testing Poly \t'

  # Construccio: coeficients de grau 0 amunt (coeffs[0] = terme independent)
  # ZZ per defecte, Q si hi ha fraccions
  p = Poly([6, -5, 1])          # x^2 - 5x + 6
  assert_eq p.degree(), NN(2)
  assert_eq p.coeffs(), [ZZ(6), ZZ(-5), ZZ(1)]

  q = Poly([3, Q(-5, 2), Q(1, 2)])   # 3 - (5/2)x + (1/2)x^2 = (1/2)(x-2)(x-3)
  assert_eq q.degree(), NN(2)
  assert_eq q.coeffs(), [Q(3), Q(-5, 2), Q(1, 2)]

  # Polinomi zero i grau
  assert_eq Poly([]).degree(), NN(0)
  assert_eq Poly([0, 0, 0]).degree(), NN(0)
  assert_eq Poly([7]).degree(), NN(0)

  # Suma / resta / multiplicacio (amb Poly i escalars)
  a = Poly([6, -5, 1])          # x^2 - 5x + 6
  b = Poly([1, 1])              # x + 1
  assert_eq a + b, Poly([7, -4, 1])
  assert_eq a - b, Poly([5, -6, 1])
  assert_eq a * b, Poly([6, 1, -4, 1])   # x^3 - 4x^2 + x + 6
  assert_eq a * 2, Poly([12, -10, 2])
  assert_eq 2 * a, Poly([12, -10, 2])
  assert_eq a * NN(2), Poly([12, -10, 2])
  assert_eq a * ZZ(2), Poly([12, -10, 2])
  assert_eq a * Q(1, 2), Poly([3, Q(-5, 2), Q(1, 2)])

  # Promocio ZZ -> Q en operacions mixtes
  mixed = Poly([Q(1, 2), 0, 1])  # x^2 + 1/2
  assert_eq mixed + a, Poly([Q(13, 2), Q(-5), Q(2)])
  assert_eq mixed * a, Poly([Q(3), Q(-5, 2), Q(13, 2), Q(-5), Q(1)])

  # eval (x pot ser Number/NN/ZZ/Q)
  assert_eq a.eval(2), ZZ(0)
  assert_eq a.eval(ZZ(3)), ZZ(0)
  assert_eq a.eval(Q(1, 2)), Q(15, 4)
  assert_eq a.eval(0.5), Q(15, 4)

  # derivative
  assert_eq a.derivative(), Poly([-5, 2])
  assert_eq Poly([5]).derivative(), Poly([])
  assert_eq Poly([1, 0, 0, 1]).derivative(), Poly([0, 0, 3])

  # gcd (monic; promou a Q si cal)
  assert_eq a.gcd(Poly([2, -3, 1])), Poly([-2, 1])
  assert_eq Poly([12, -10, 2]).gcd(Poly([2, -3, 1])), Poly([-2, 1])
  assert_eq Poly([Q(1, 2), 0, Q(1, 2)]).gcd(Poly([Q(1, 3), 0, Q(1, 3)])), Poly([1, 0, 1])

  # factor: x^2 - 5x + 6 -> (x-2)(x-3)
  f = a.factor()
  assert_eq f, [(Poly([-2, 1]), NN(1)), (Poly([-3, 1]), NN(1))]

  # factor sobre Q
  fq = q.factor()
  assert_eq fq, [(Poly([-2, 1]), NN(1)), (Poly([-3, 1]), NN(1))]

  # factor irreductible (sobre ZZ i sobre Q)
  fi = Poly([1, 0, 1]).factor()
  assert_eq fi, [(Poly([1, 0, 1]), NN(1))]
  fiq = Poly([Q(3, 2), Q(-5, 2), Q(1, 2)]).factor()
  assert_eq fiq, [(Poly([3, -5, 1]), NN(1))]

  # display: format estandard ascendent amb variable x
  assert_eq '{a}', '6 - 5x + x^2'
  assert_eq '{Poly([0])}', '0'
  assert_eq '{Poly([-1, 0, 1])}', '-1 + x^2'
  assert_eq '{Poly([1, 1])}', '1 + x'
  assert_eq '{Poly([3, 0, -2])}', '3 - 2x^2'
  assert_eq '{Poly([Q(1, 2), 0, 1])}', '(1/2) + x^2'
  assert_eq '{Poly([Q(-3, 2), Q(1, 2)])}', '-(3/2) + (1/2)x'

  # Errors: constructor sense llista i operacions amb tipus incorrectes
  caught = try
    Poly(1)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Poly([1, 2]) + 5
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Poly([1, 2]).eval('x')
  catch e
    'caught'
  assert_eq caught, 'caught'


@test mat_tests = ||
  write 'Testing Mat \t'

  # Construccio: matriu per files, auto ZZ si tots enters
  m = Mat([[1, 2], [3, 4]])
  assert_eq m.rows(), NN(2)
  assert_eq m.cols(), NN(2)
  assert_eq m.at(0, 0), ZZ(1)
  assert_eq m.at(0, 1), ZZ(2)
  assert_eq m.at(1, 0), ZZ(3)
  assert_eq m.at(1, 1), ZZ(4)
  assert_eq Mat([[1, 2], [3, 4]]), Mat([[1, 2], [3, 4]])

  # Amb fraccions -> Mat sobre Q
  mq = Mat([[Q(1, 2), Q(1, 2)], [Q(1, 3), Q(2, 3)]])
  assert_eq mq.rows(), NN(2)
  assert_eq mq.cols(), NN(2)
  assert_eq mq.at(0, 0), Q(1, 2)
  assert_eq mq.at(1, 1), Q(2, 3)

  # transpose
  assert_eq m.transpose(), Mat([[1, 3], [2, 4]])
  assert_eq m.transpose().transpose(), m

  # mul (metode i operador *)
  assert_eq m.mul(Mat([[5, 6], [7, 8]])), Mat([[19, 22], [43, 50]])
  assert_eq m * Mat([[5, 6], [7, 8]]), Mat([[19, 22], [43, 50]])

  # Suma / resta
  assert_eq m + Mat([[1, 1], [1, 1]]), Mat([[2, 3], [4, 5]])
  assert_eq m - Mat([[1, 1], [1, 1]]), Mat([[0, 1], [2, 3]])
  assert_eq m + mq, Mat([[Q(3, 2), Q(5, 2)], [Q(10, 3), Q(14, 3)]])

  # Multiplicacio per escalar
  assert_eq m * 2, Mat([[2, 4], [6, 8]])
  assert_eq m * Q(1, 2), Mat([[Q(1, 2), 1], [Q(3, 2), 2]])

  # det
  assert_eq m.det(), ZZ(-2)
  assert_eq mq.det(), Q(1, 6)
  assert_eq Mat([[1, 2, 3], [0, 1, 4], [5, 6, 0]]).det(), ZZ(1)

  # inverse (sobre Q; ZZ promociona a Q)
  inv = m.inverse()
  assert_eq inv, Mat([[-2, 1], [Q(3, 2), Q(-1, 2)]])
  assert_eq inv * m, Mat([[1, 0], [0, 1]])
  assert_eq mq.inverse() * mq, Mat([[1, 0], [0, 1]])

  # lll: reduccio LLL d'enters (novetat 0.0.16/0.0.17)
  # Exemple classic 2D: base {(1,1), (1,2)} -> base reduida {(-1,0), (0,1)}
  assert_eq Mat([[1, 1], [1, 2]]).lll(), Mat([[-1, 0], [0, 1]])
  assert_eq Mat([[1, 2], [3, 4]]).lll(), Mat([[1, 0], [0, 2]])
  # Exemple 3D
  assert_eq Mat([[1, 1, 0], [1, 0, 1]]).lll(), Mat([[1, 1, 0], [0, -1, 1]])

  # Display: files separades per , dins de [[...]] (format koto)
  assert_eq '{Mat([[1, 2], [3, 4]])}', '[[1, 2], [3, 4]]'
  assert_eq '{Mat([[Q(1, 2), 1], [3, 4]])}', '[[1/2, 1], [3, 4]]'

  # Errors
  caught = try
    Mat([[1, 2], [3]])
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    m.at(5, 0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Mat([[1, 2, 3], [4, 5, 6]]).det()
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Mat([[1, 2], [2, 4]]).inverse()
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    mq.lll()
  catch e
    'caught'
  assert_eq caught, 'caught'


@test quat_tests = ||
  write 'Testing Quat \t'

  # Construccio: 4 coeficients Q (Number/NN/ZZ promocionats a Q)
  assert_eq Quat(1, 2, 3, 4).coeffs(), (Q(1), Q(2), Q(3), Q(4))
  assert_eq Quat(Q(1, 2), 2, 3, 4).coeffs(), (Q(1, 2), Q(2), Q(3), Q(4))
  assert_eq Quat(1, 2, 3, 4), Quat(Q(1), Q(2), Q(3), Q(4))
  assert Quat(1, 2, 3, 4) != Quat(1, 2, 3, 5)
  assert_eq Quat(0, 0, 0, 0), Quat(0, 0, 0, Q(0))

  # Suma i resta
  q = Quat(1, 2, 3, 4)
  assert_eq q + Quat(1, -2, -3, -4), Quat(2, 0, 0, 0)
  assert_eq q - Quat(1, -2, -3, -4), Quat(0, 4, 6, 8)
  assert_eq q + 1, Quat(2, 2, 3, 4)
  assert_eq 1 + q, Quat(2, 2, 3, 4)
  assert_eq q - Q(1, 2), Quat(Q(1, 2), 2, 3, 4)
  assert_eq 1 - q, Quat(0, -2, -3, -4)

  # Multiplicacio per escalar
  assert_eq q * 2, Quat(2, 4, 6, 8)
  assert_eq 2 * q, Quat(2, 4, 6, 8)
  assert_eq q * Q(1, 2), Quat(Q(1, 2), 1, Q(3, 2), 2)

  # Regles de Hamilton: i^2 = j^2 = k^2 = ijk = -1, i*j = k, j*i = -k
  i = Quat(0, 1, 0, 0)
  j = Quat(0, 0, 1, 0)
  k = Quat(0, 0, 0, 1)
  assert_eq i * i, Quat(-1, 0, 0, 0)
  assert_eq j * j, Quat(-1, 0, 0, 0)
  assert_eq k * k, Quat(-1, 0, 0, 0)
  assert_eq i * j, k
  assert_eq j * i, -k
  assert_eq j * k, i
  assert_eq k * j, -i
  assert_eq k * i, j
  assert_eq i * k, -j
  # Associativitat: (i*j)*k = i*(j*k) = -1
  assert_eq (i * j) * k, Quat(-1, 0, 0, 0)
  assert_eq i * (j * k), Quat(-1, 0, 0, 0)

  # Exemples coneguts (verificats contra la definicio)
  assert_eq Quat(1, 2, 0, 0) * Quat(3, 4, 0, 0), Quat(-5, 10, 0, 0)
  assert_eq Quat(1, 1, 0, 0) * Quat(2, 0, 1, 0), Quat(2, 2, 1, 1)
  assert_eq Quat(2, 0, 1, 0) * Quat(1, 1, 0, 0), Quat(2, 2, 1, -1)
  # No commutativa
  assert Quat(1, 1, 0, 0) * Quat(2, 0, 1, 0) != Quat(2, 0, 1, 0) * Quat(1, 1, 0, 0)
  # (1+i)(1-i) = 2
  assert_eq Quat(1, 1, 0, 0) * Quat(1, -1, 0, 0), Quat(2, 0, 0, 0)
  # q * conj(q) = norma
  assert_eq q * q.conjugate(), Quat(30, 0, 0, 0)
  # Casos amb termes creuats j/k i i/k (regressio del signe de la
  # multiplicacio; (1+j)(1+k) = 1 + i + j + k)
  assert_eq Quat(1, 0, 1, 0) * Quat(1, 0, 0, 1), Quat(1, 1, 1, 1)
  assert_eq Quat(1, 2, 3, 4) * Quat(5, 6, 7, 8), Quat(-60, 12, 30, 24)

  # Conjugacio, norma reduida i traca reduida
  assert_eq q.conjugate(), Quat(1, -2, -3, -4)
  assert_eq q.conjugate().conjugate(), q
  assert_eq q.norm(), Q(30)
  assert_eq i.norm(), Q(1)
  assert_eq Quat(3, -4, 0, 0).norm(), Q(25)
  assert_eq Quat(0, 0, 0, 0).norm(), Q(0)
  assert_eq q.trace(), Q(2)
  assert_eq Quat(3, -4, 0, 0).trace(), Q(6)
  assert_eq i.trace(), Q(0)
  assert_eq q.norm(), q.conjugate().norm()

  # coeffs i to_float
  assert_eq Quat(1, 2, 3, 4).to_float(), (1.0, 2.0, 3.0, 4.0)
  assert_eq Quat(Q(1, 2), 0, 0, 0).to_float(), (0.5, 0.0, 0.0, 0.0)

  # Display: signes correctes i fraccions reduides
  assert_eq '{Quat(1, 2, -3, Q(1, 2))}', '1 + 2i - 3j + (1/2)k'
  assert_eq '{Quat(0, 1, 0, 0)}', 'i'
  assert_eq '{Quat(0, 0, 0, 0)}', '0'
  assert_eq '{Quat(-1, 0, 0, 0)}', '-1'
  assert_eq '{Quat(1, -2, 0, 0)}', '1 - 2i'
  assert_eq '{Quat(0, 0, 1, -1)}', 'j - k'
  assert_eq '{Quat(Q(1, 3), 0, 0, Q(-2, 3))}', '1/3 - (2/3)k'

  # Errors: arguments incorrectes
  caught = try
    Quat(1, 2)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Quat(1, 2, 3, 4, 5)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Quat('a', 2, 3, 4)
  catch e
    'caught'
  assert_eq caught, 'caught'


@test alg_tests = ||
  write 'Testing Alg \t'

  # Construccio: Alg(Poly) o Alg(llista de coeficients) -> llista d'arrels
  # reals aillades en ordre creixent (amb multiplicitat)
  roots = Alg(Poly([-2, 0, 1]))     # x^2 - 2
  assert_eq size(roots), 2
  assert roots[0] < roots[1]

  # Comparacio exacta entre Alg
  assert_eq roots[0].cmp(roots[1]), -1
  assert_eq roots[1].cmp(roots[0]), 1
  assert_eq roots[0].cmp(roots[0]), 0
  assert_eq roots[0], roots[0]
  assert roots[0] != roots[1]
  assert roots[0] <= roots[0]
  assert roots[1] >= roots[1]

  # sqrt(2) = roots[1] (l'arrel positiva)
  sqrt2 = roots[1]
  assert sqrt2.to_float() > 1.41
  assert sqrt2.to_float() < 1.42
  # Comparacio exacta amb racionals (arrels de polinomis lineals)
  assert_eq sqrt2.cmp(Alg(Poly([-141, 100]))[0]), 1   # sqrt2 > 141/100
  assert_eq sqrt2.cmp(Alg(Poly([-142, 100]))[0]), -1  # sqrt2 < 142/100
  assert sqrt2 > Q(141, 100)
  assert sqrt2 < 1.42

  # x^2 + 1 -> cap arrel real
  assert_eq size(Alg(Poly([1, 0, 1]))), 0
  # Grau 0 (constant i zero) -> cap arrel
  assert_eq size(Alg(Poly([5]))), 0
  assert_eq size(Alg(Poly([]))), 0
  # Constructor amb llista de coeficients
  assert_eq size(Alg([-2, 0, 1])), 2
  # Multiplicitat: (x-1)^2 -> dues arrels (1 i 1)
  assert_eq size(Alg(Poly([1, -2, 1]))), 2

  # Arrel racional (polinomi lineal): x - 6 -> [6]
  rat = Alg(Poly([-6, 1]))[0]
  assert_eq rat.to_float(), 6.0
  assert_eq rat.accuracy(), Q(0)
  assert_eq rat.min_poly(), Poly([-6, 1])
  assert_eq rat.cmp(Q(6)), 0
  assert_eq rat, Q(6)

  # min_poly de les arrels de x^2 - 2
  assert_eq sqrt2.min_poly(), Poly([-2, 0, 1])
  assert_eq roots[0].min_poly(), Poly([-2, 0, 1])

  # accuracy inicial: interval d'aillament no buit
  assert roots[0].accuracy() > Q(0)

  # Refinament: accuracy demanada assolida, mateix nombre
  r = sqrt2.refine(Q(1, 1000))
  assert r.accuracy() < Q(1, 1000)
  assert r.accuracy() > Q(0)
  assert_eq r.cmp(sqrt2), 0
  r2 = sqrt2.refine(Q(1, 1000000))
  assert r2.accuracy() <= r.accuracy()
  assert_eq r2.cmp(sqrt2), 0

  # Display: aproximacio decimal (iracionals) / fraccio (racionals)
  assert '{sqrt2}'.starts_with('1.414')
  assert '{roots[0]}'.starts_with('-1.414')
  assert_eq '{rat}', '6'

  # Errors
  caught = try
    Alg(5)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Alg('x')
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    sqrt2.refine(0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    sqrt2.refine(Q(-1, 2))
  catch e
    'caught'
  assert_eq caught, 'caught'


@test ideal_tests = ||
  write 'Testing Ideal/ZZn \t'

  # Construccio: Ideal(6) = 6Z; Ideal(4, 6) = gcd(4, 6)Z = 2Z
  assert_eq Ideal(6), Ideal(6)
  assert_eq Ideal(4, 6), Ideal(2)
  assert_eq Ideal(-4, 6), Ideal(2)       # signes ignorats (generador canonic >= 0)
  assert_eq Ideal(0), Ideal(0)
  assert_eq Ideal(4, 6).generator(), NN(2)
  assert_eq Ideal(6).generator(), NN(6)

  # contains (amb NN, ZZ i Number)
  assert Ideal(6).contains(12)
  assert Ideal(6).contains(NN(6))
  assert Ideal(6).contains(ZZ(-12))
  assert not Ideal(6).contains(5)
  assert Ideal(0).contains(0)
  assert not Ideal(0).contains(3)
  assert Ideal(1).contains(17)            # ZZ sencer

  # sum = gcd, intersect = lcm, product = producte
  assert_eq Ideal(6).sum(Ideal(15)), Ideal(3)
  assert_eq Ideal(6).intersect(Ideal(15)), Ideal(30)
  assert_eq Ideal(6).product(Ideal(15)), Ideal(90)
  assert_eq Ideal(4, 6).sum(Ideal(10)), Ideal(2)
  assert_eq Ideal(4).intersect(Ideal(6)), Ideal(12)

  # quotient d'ideals (I : J) = { x : xJ subset I }
  assert_eq Ideal(6).quotient(Ideal(2)), Ideal(3)
  assert_eq Ideal(6).quotient(Ideal(6)), Ideal(1)
  assert_eq Ideal(6).quotient(Ideal(0)), Ideal(1)

  # equals (i operador ==)
  assert Ideal(4, 6).equals(Ideal(2))
  assert not Ideal(4, 6).equals(Ideal(4))
  assert Ideal(6) == Ideal(-6)

  # Display: generador canonic + Z
  assert_eq '{Ideal(6)}', '6Z'
  assert_eq '{Ideal(4, 6)}', '2Z'
  assert_eq '{Ideal(0)}', '0Z'

  # ZZn: aritmetica modular
  assert_eq ZZn(6).of(7) + ZZn(6).of(5), ZZn(6).of(0)   # 7 + 5 = 12 = 0 mod 6
  assert_eq ZZn(6).of(7) - ZZn(6).of(5), ZZn(6).of(2)   # 7 - 5 = 2 mod 6
  assert_eq ZZn(6).of(7) * ZZn(6).of(5), ZZn(6).of(5)   # 7 * 5 = 35 = 5 mod 6
  assert_eq -ZZn(6).of(1), ZZn(6).of(5)                 # -1 = 5 mod 6
  assert_eq ZZn(6).of(-1), ZZn(6).of(5)                 # representants canonics
  assert_eq ZZn(7).of(7), ZZn(7).of(0)
  assert ZZn(6).of(2) != ZZn(6).of(3)

  # invers de 5 mod 7 = 3 (5 * 3 = 15 = 1 mod 7)
  assert_eq ZZn(7).of(5).inverse(), ZZn(7).of(3)
  assert_eq ZZn(7).of(3).inverse(), ZZn(7).of(5)
  assert_eq ZZn(11).of(4).inverse(), ZZn(11).of(3)      # 4 * 3 = 12 = 1 mod 11
  assert_eq ZZn(1).of(0).inverse(), ZZn(1).of(0)        # anell trivial: 0 = 1

  # Display: [x] mod n
  assert_eq '{ZZn(6).of(7)}', '[1] mod 6'
  assert_eq '{ZZn(7).of(5)}', '[5] mod 7'

  # Errors
  caught = try
    Ideal('a')
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Ideal(6).contains('a')
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    ZZn(0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    ZZn(-6)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    ZZn(6).of(2).inverse()      # 2 no es coprimer amb 6
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    ZZn(6).of(1) + ZZn(7).of(1) # moduls diferents
  catch e
    'caught'
  assert_eq caught, 'caught'

@test ff_tests = ||
  write 'Testing FF \t'

  # --- GF(7): construccio i elements ---
  assert_eq FF(7).char(), NN(7)
  assert_eq FF(7).degree(), NN(1)
  assert_eq '{FF(7)}', 'GF(7)'
  assert_eq FF(7).of(3), FF(7).of(3)
  assert_eq FF(7).of(-1), FF(7).of(6)        # representants canonics 0..p-1
  assert_eq FF(7).of(10), FF(7).of(3)        # reduccio mod p
  assert_eq FF(7).of(NN(3)), FF(7).of(3)
  assert_eq FF(7).of(ZZ(-8)), FF(7).of(6)    # -8 = 6 mod 7
  assert_eq FF(7).of(3).char(), NN(7)
  assert_eq FF(7).of(3).coeffs(), [NN(3)]

  # --- aritmetica a GF(7) ---
  assert_eq FF(7).of(3) + FF(7).of(5), FF(7).of(1)   # 3 + 5 = 8 = 1 mod 7
  assert_eq FF(7).of(3) * FF(7).of(5), FF(7).of(1)   # 3 * 5 = 15 = 1 mod 7
  assert_eq FF(7).of(3) - FF(7).of(5), FF(7).of(5)   # 3 - 5 = -2 = 5 mod 7
  assert_eq -FF(7).of(3), FF(7).of(4)                # -3 = 4 mod 7
  assert_eq FF(7).of(3) / FF(7).of(5), FF(7).of(2)   # 3 / 5 = 3 * 3 = 9 = 2 mod 7
  assert_eq FF(7).of(6) / FF(7).of(6), FF(7).of(1)
  assert FF(7).of(3) != FF(7).of(4)

  # --- inversa, potencies i ordre a GF(7) ---
  assert_eq FF(7).of(3).inverse(), FF(7).of(5)   # 3 * 5 = 1 mod 7
  assert_eq FF(7).of(5).inverse(), FF(7).of(3)
  assert_eq FF(7).of(1).inverse(), FF(7).of(1)
  assert_eq FF(7).of(2).pow(100), FF(7).of(2)    # 2^3 = 1, 2^100 = 2^(99+1) = 2
  assert_eq FF(7).of(3).pow(0), FF(7).of(1)
  assert_eq FF(7).of(0).pow(5), FF(7).of(0)
  assert_eq FF(7).of(2).pow(-1), FF(7).of(4)     # 2^-1 = 4 (2*4 = 8 = 1 mod 7)
  assert_eq FF(7).of(2).pow(-2), FF(7).of(2)     # 4^2 = 16 = 2 mod 7
  assert_eq FF(7).of(3).order(), NN(6)           # 3 es primitiu mod 7
  assert_eq FF(7).of(2).order(), NN(3)           # 2^3 = 8 = 1 mod 7
  assert_eq FF(7).of(6).order(), NN(2)           # -1 te ordre 2
  assert_eq FF(7).of(1).order(), NN(1)

  # Display de GF(p): l'enter 0..p-1
  assert_eq '{FF(7).of(3)}', '3'
  assert_eq '{FF(7).of(6)}', '6'

  # --- GF(4) = GF(2)[x]/(x^2 + x + 1), Conway [2,2] ---
  assert_eq FF(2, 2).char(), NN(2)
  assert_eq FF(2, 2).degree(), NN(2)
  assert_eq '{FF(2, 2)}', 'GF(2^2)'
  x = FF(2, 2).of([0, 1])           # x
  x1 = FF(2, 2).of([1, 1])          # x + 1
  assert_eq x * x, x1               # x^2 = x + 1 (perque x^2 + x + 1 = 0)
  assert_eq x * x1, FF(2, 2).of(1)  # x * (x + 1) = 1
  assert_eq x1 * x1, x              # (x + 1)^2 = x
  assert_eq x + x1, FF(2, 2).of(1)
  assert_eq x + x, FF(2, 2).of(0)
  assert_eq x - x1, FF(2, 2).of(1)  # x - (x+1) = -1 = 1 mod 2
  assert_eq -x1, x1                 # -(x + 1) = x + 1 mod 2
  assert_eq x.inverse(), x1
  assert_eq x1.inverse(), x
  assert_eq x / x1, x1              # x / (x+1) = x * x = x^2 = x + 1 (x^2 + x + 1 = 0)
  assert_eq x.order(), NN(3)        # grup multiplicatiu d'ordre 3
  assert_eq x1.order(), NN(3)
  assert_eq x.pow(3), FF(2, 2).of(1)
  assert_eq x.pow(-1), x1
  assert_eq FF(2, 2).of([1, 0, 1]), x      # x^2 + 1 es redueix a x
  assert_eq FF(2, 2).of([3, 5]), x1        # coeficients reduits mod 2: [1, 1]
  assert_eq FF(2, 2).of(2), FF(2, 2).of(0) # 2 = 0 mod 2
  assert_eq x.coeffs(), [NN(0), NN(1)]

  # Display de GF(p^k): polinomi en ordre descendent de grau
  assert_eq '{x}', 'x'
  assert_eq '{x1}', 'x + 1'
  assert_eq '{FF(3, 2).of([1, 2])}', '2x + 1'
  assert_eq '{FF(3, 2).of(2)}', '2'

  # --- GF(9) = GF(3)[x]/(x^2 + 2x + 2), Conway [3,2] ---
  assert_eq FF(3, 2).char(), NN(3)
  assert_eq FF(3, 2).degree(), NN(2)
  y = FF(3, 2).of([0, 1])                  # x
  assert_eq y * y, FF(3, 2).of([1, 1])     # x^2 = x + 1 (mod 3)
  assert_eq y.inverse(), FF(3, 2).of([2, 1])  # x^-1 = x + 2: x(x+2) = x^2+2x = 1
  assert_eq y.order(), NN(8)               # x es primitiu a GF(9)* (ordre 8)
  assert_eq y.pow(8), FF(3, 2).of(1)
  assert_eq FF(3, 2).of([1, 1]) * FF(3, 2).of([1, 1]), FF(3, 2).of(2)  # (x+1)^2 = 2
  assert_eq FF(3, 2).of([2, 2]) + FF(3, 2).of([1, 1]), FF(3, 2).of(0)  # (2x+2)+(x+1)=0
  assert_eq y / FF(3, 2).of(2), FF(3, 2).of([0, 2])  # x / 2 = 2x (2^-1 = 2)
  assert_eq y.pow(-1), FF(3, 2).of([2, 1])

  # --- GF(8) = GF(2)[x]/(x^3 + x + 1), Conway [2,3] ---
  assert_eq FF(2, 3).char(), NN(2)
  z = FF(2, 3).of([0, 1, 0])               # x
  assert_eq z.pow(3), FF(2, 3).of([1, 1])  # x^3 = x + 1
  assert_eq z.pow(7), FF(2, 3).of(1)       # x^7 = 1
  assert_eq z.order(), NN(7)               # grup multiplicatiu d'ordre 7 (primer)
  assert_eq z.pow(100), FF(2, 3).of([0, 0, 1])  # x^100 = x^(7*14+2) = x^2
  assert_eq z.inverse(), FF(2, 3).of([1, 0, 1])  # x(x^2+1) = x^3+x = 1
  assert_eq '{z.pow(3)}', 'x + 1'

  # --- Errors ---
  caught = try
    FF(4)                    # 4 no es primer
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(1)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(-7)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(7, 0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(7).of(0).inverse()    # 0 no te invers
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(7).of(1) / FF(7).of(0)  # divisio per zero
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(7).of(0).order()      # 0 no te ordre multiplicatiu
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(7).of(0).pow(-1)      # potenciacio negativa de 0
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(7).of(1) + FF(11).of(1)  # cossos primers diferents
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF(2, 2).of(1) + FF(7).of(1)  # GF(4) amb GF(7)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    FF('a')
  catch e
    'caught'
  assert_eq caught, 'caught'


@test nt2_tests = ||
  write 'Testing NT2 \t'

  # ---- Quadratic symbols: Legendre (a/p) with p an odd prime ----
  # Squares mod 7 are {1, 2, 4}, so (2/7) = 1 and (3/7) = -1.
  assert_eq legendre(2, 7), ZZ(1)
  assert_eq legendre(3, 7), ZZ(-1)
  assert_eq legendre(1, 7), ZZ(1)
  assert_eq legendre(4, 7), ZZ(1)
  assert_eq legendre(5, 7), ZZ(-1)
  assert_eq legendre(6, 7), ZZ(-1)
  assert_eq legendre(0, 7), ZZ(0)
  assert_eq legendre(-1, 7), ZZ(-1)  # 7 = 3 mod 4
  assert_eq legendre(2, 13), ZZ(-1)  # 13 = 5 mod 8
  assert_eq legendre(NN(2), ZZ(7)), ZZ(1)  # accepts NN/ZZ

  # Legendre errors: p must be an odd prime
  caught = try
    legendre(1, 9)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    legendre(1, 2)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    legendre(1, -3)
  catch e
    'caught'
  assert_eq caught, 'caught'

  # ---- Jacobi (a/n) with n odd (no primality required) ----
  assert_eq jacobi(2, 9), ZZ(1)  # (2/3)^2
  assert_eq jacobi(3, 9), ZZ(0)  # 3 | 9
  assert_eq jacobi(5, 9), ZZ(1)  # (5/3)^2 = (-1)^2
  assert_eq jacobi(2, 15), ZZ(1)  # (2/3)(2/5) = (-1)(-1)
  assert_eq jacobi(7, 15), ZZ(-1)  # (7/3)(7/5) = (1)(-1)
  assert_eq jacobi(-1, 9), ZZ(1)  # (-1)^((9-1)/2) = 1
  assert_eq jacobi(1, 1), ZZ(1)

  # Jacobi errors: n must be odd
  caught = try
    jacobi(1, 2)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    jacobi(1, 0)
  catch e
    'caught'
  assert_eq caught, 'caught'

  # ---- Kronecker (a/n): extends to even and negative n ----
  assert_eq kronecker(2, 7), ZZ(1)  # coincides with Legendre for odd primes
  assert_eq kronecker(3, 7), ZZ(-1)
  assert_eq kronecker(2, 8), ZZ(0)  # (2/2)^3 = 0
  assert_eq kronecker(3, 8), ZZ(-1)  # 3 = 3 mod 8
  assert_eq kronecker(-1, 4), ZZ(1)  # (-1)^2 factor
  assert_eq kronecker(2, -1), ZZ(1)  # sign convention for n = -1
  assert_eq kronecker(-2, -1), ZZ(-1)
  assert_eq kronecker(1, 0), ZZ(1)  # (1/0) = 1
  assert_eq kronecker(2, 0), ZZ(0)
  assert_eq kronecker(4, 12), ZZ(0)

  # ---- Continued fractions ----
  # Finite CF: 22/7 = [3, 7]
  assert_eq CF([3, 7]).value(), Q(22, 7)
  assert_eq CF([3, 7]).convergent(0), Q(3)
  assert_eq CF([3, 7]).convergent(1), Q(22, 7)
  assert_eq CF([3, 7]).to_float(), 22.0 / 7.0
  assert_eq CF([3, 7]).take(4), [ZZ(3), ZZ(7)]
  assert_eq '{CF([3, 7])}', '[3, 7]'
  assert_eq '{CF([1, 2, 3])}', '[1, 2, 3]'

  # Periodic CF: sqrt(2) = [1; 2, 2, ...]
  s2 = CF.periodic([1], [2])
  assert_eq s2.convergent(0), Q(1)
  assert_eq s2.convergent(1), Q(3, 2)
  assert_eq s2.convergent(2), Q(7, 5)
  assert_eq s2.convergent(3), Q(17, 12)
  assert_eq s2.convergent(4), Q(41, 29)
  assert_eq '{s2}', '[1; 2]'

  # Periodic CF: golden ratio = [1; 1, 1, ...] (Fibonacci ratios)
  phi = CF.periodic([1], [1])
  assert_eq phi.convergent(4), Q(8, 5)

  # Euler's constant e = [2; 1, 2, 1, 1, 4, 1, 1, 6, ...]
  e_cf = eulers_constant()
  assert_eq e_cf.take(9), [ZZ(2), ZZ(1), ZZ(2), ZZ(1), ZZ(1), ZZ(4), ZZ(1), ZZ(1), ZZ(6)]
  assert_eq e_cf.convergent(0), Q(2)
  assert_eq e_cf.convergent(1), Q(3)
  assert_eq e_cf.convergent(2), Q(8, 3)
  assert_eq e_cf.convergent(5), Q(87, 32)

  # Q.to_cf(): Euclidean algorithm (values match algebraeon's own tests)
  assert_eq Q(22, 7).to_cf(), CF([3, 7])
  assert_eq Q(9, 10).to_cf(), CF([0, 1, 9])
  assert_eq Q(-9, 10).to_cf(), CF([-1, 10])
  assert_eq Q(-5678, 1234).to_cf(), CF([-5, 2, 1, 1, 30, 4])
  assert_eq Q(2).to_cf(), CF([2])

  # CF errors
  caught = try
    CF([1, 0])  # coefficient after the first must be positive
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    CF.periodic([], [])  # empty repeating part
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    CF.periodic([2], [-1])  # negative repeating coefficient
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    CF.periodic([1], [2]).value()  # periodic CF has no rational value
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    CF([3, 7]).convergent(2)  # finite CF too short
  catch e
    'caught'
  assert_eq caught, 'caught'

  # ---- Q: simplest_between / approximate ----
  assert_eq Q(1, 3).simplest_between(Q(1, 2)), Q(1, 2)
  assert_eq Q(-1, 3).simplest_between(Q(1, 3)), Q(0)
  assert_eq Q(1, 3).simplest_between(Q(2, 5)), Q(1, 3)
  assert_eq Q(1, 3).simplest_between(Q(1, 3)), Q(1, 3)
  assert_eq Q(355, 113).approximate(NN(100)), Q(311, 99)
  assert_eq Q(355, 113).approximate(NN(10)), Q(22, 7)
  assert_eq Q(22, 7).approximate(NN(10)), Q(22, 7)
  caught = try
    Q(1, 2).simplest_between(Q(1, 3))  # requires self <= other
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Q(1, 2).approximate(NN(0))  # max_denominator must be positive
  catch e
    'caught'
  assert_eq caught, 'caught'


@main = ||
  print 'Algebraeon Koto tests passed'
