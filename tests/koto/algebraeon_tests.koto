# Algebraeon interoperability checks written directly in Koto.
# Run with: `cargo run -- --tests tests/koto/algebraeon_tests.koto`

write = |s| io.stdout().write(s)
from algebraeon import NN, ZZ, Q, Mat, Poly

@post_test = ||
  print 'ok'

@test nn_tests = ||
  write 'Testing NN \t'
  assert_eq NN(5).factorial(), NN(120)
  assert_eq NN(5) - NN(3), NN(2)

  assert NN(16).is_square()
  assert not NN(18).is_square()
  assert_eq NN(17).sqrt_floor(), NN(4)
  assert_eq NN(17).sqrt_ceil(), NN(5)

  a = NN(5)
  a += NN(1)
  a *= NN(2)
  assert_eq a, NN(12)

@test zz_tests = ||
  write 'Testing ZZ \t'
  assert_eq ZZ(-9).abs(), NN(9)
  assert ZZ(9).is_square()
  assert not ZZ(10).is_square()

  assert_eq ZZ(5) + ZZ(-3), ZZ(2)
  assert_eq ZZ(5) + NN(3), ZZ(8)
  assert_eq ZZ(7) + 5, ZZ(12)
  assert_eq ZZ(4) * ZZ(-2), ZZ(-8)

  a = ZZ(5)
  a += ZZ(1)
  a += 1
  a += NN(2)
  a *= NN(3)
  a *= 2
  assert_eq a, ZZ(54)

@test numtheory_tests = ||
  write 'Testing numtheory \t'

  # NN.primes: first 10 primes as an iterator
  primes10 = NN.primes().take(10).to_list()
  assert_eq primes10, [NN(2), NN(3), NN(5), NN(7), NN(11), NN(13), NN(17), NN(19), NN(23), NN(29)]

  # divisors
  assert_eq NN(12).divisors(), [NN(1), NN(2), NN(3), NN(4), NN(6), NN(12)]
  assert_eq NN(1).divisors(), [NN(1)]

  # euler_totient
  assert_eq NN(10).euler_totient(), NN(4)
  assert_eq NN(1).euler_totient(), NN(1)
  assert_eq NN(12).euler_totient(), NN(4)

  # is_squarefree
  assert not NN(12).is_squarefree()
  assert NN(10).is_squarefree()
  assert NN(1).is_squarefree()

  # is_power_test
  assert_eq NN(8).is_power_test(), (true, NN(2), NN(3))
  assert_eq NN(6).is_power_test(), (false, null, null)

  # primality_test
  assert_eq NN(17).primality_test(), 'prime'
  assert_eq NN(12).primality_test(), 'composite'
  assert_eq NN(1).primality_test(), 'composite'

  # ZZ::factor: negative integer, unit -1 ignored
  assert_eq ZZ(-12).factor(), [(ZZ(2), NN(2)), (ZZ(3), NN(1))]
  assert_eq ZZ(12).factor(), [(ZZ(2), NN(2)), (ZZ(3), NN(1))]

  # ZZ::divmod / div_floor / mod
  assert_eq ZZ(-7).divmod(ZZ(3)), (ZZ(-3), ZZ(2))
  assert_eq ZZ(-7).div_floor(ZZ(3)), ZZ(-3)
  assert_eq ZZ(-7).mod(ZZ(3)), ZZ(2)
  assert_eq ZZ(13).div_floor(ZZ(5)), ZZ(2)
  assert_eq ZZ(13).mod(ZZ(5)), ZZ(3)
  assert_eq ZZ(-13).div_floor(ZZ(5)), ZZ(-3)
  assert_eq ZZ(-13).mod(ZZ(5)), ZZ(2)
  assert_eq ZZ(4).mod(ZZ(3)), ZZ(1)
  assert_eq ZZ(-4).mod(ZZ(3)), ZZ(2)


@test q_tests = ||
  write 'Testing Q \t'

  # Constructor i reduccio
  assert_eq Q(6, 4), Q(3, 2)
  assert_eq Q(-2, -4), Q(1, 2)
  assert_eq Q(0, 5), Q(0, 1)
  assert_eq Q(NN(1), NN(2)), Q(1, 2)
  assert_eq Q(ZZ(-1), ZZ(2)), Q(-1, 2)
  assert_eq Q(Q(1, 2)), Q(1, 2)
  assert_eq Q(0.5), Q(1, 2)
  assert_eq Q(2), Q(2, 1)

  # Aritmetica amb Q, NN, ZZ i Number
  assert_eq Q(1, 2) + Q(1, 3), Q(5, 6)
  assert_eq Q(1, 2) - Q(1, 4), Q(1, 4)
  assert_eq Q(2, 3) * Q(3, 4), Q(1, 2)
  assert_eq Q(1, 2) / Q(3, 4), Q(2, 3)
  assert_eq Q(1, 2) + 1, Q(3, 2)
  assert_eq Q(1, 2) + NN(1), Q(3, 2)
  assert_eq Q(1, 2) + ZZ(1), Q(3, 2)
  assert_eq Q(1, 2) * 4, Q(2)
  assert_eq Q(1, 2) / ZZ(2), Q(1, 4)
  assert_eq -Q(1, 2), Q(-1, 2)

  # Assignacio += -= *= /=
  a = Q(1, 2)
  a += Q(1, 4)
  a *= 2
  a -= NN(1)
  a /= ZZ(4)
  assert_eq a, Q(1, 8)

  # Comparacions (amb Q i Number)
  assert Q(1, 2) < Q(3, 4)
  assert Q(3, 4) > Q(1, 2)
  assert Q(1, 2) <= Q(1, 2)
  assert Q(1, 2) >= Q(1, 2)
  assert Q(1, 2) != Q(2, 3)
  assert_eq Q(1, 2) == 0.5, true
  assert Q(1, 2) < 1
  assert Q(3, 2) > 1.25

  # Metodes num/den/is_integer/is_square/sqrt_if_square/height/to_float
  assert_eq Q(3, 2).num(), ZZ(3)
  assert_eq Q(-3, 2).num(), ZZ(-3)
  assert_eq Q(3, 2).den(), NN(2)
  assert_eq Q(3).den(), NN(1)
  assert Q(4, 2).is_integer()
  assert not Q(3, 2).is_integer()
  assert Q(4, 9).is_square()
  assert not Q(2, 3).is_square()
  assert_eq Q(4, 9).sqrt_if_square(), Q(2, 3)
  assert_eq Q(2, 3).sqrt_if_square(), null
  assert_eq Q(3, 2).height(), NN(3)
  assert_eq Q(-2, 5).height(), NN(5)
  assert_eq Q(3, 2).to_float(), 1.5
  assert_eq Q(-7, 4).to_float(), -1.75

  # Conversions Q -> ZZ / NN
  assert_eq Q(3).to_zz(), ZZ(3)
  assert_eq Q(4, 2).to_zz(), ZZ(2)
  assert_eq Q(4, 2).to_nn(), NN(2)
  assert_eq Q(0).to_nn(), NN(0)

  # Display: fraccio reduida num/den, i nomes num si den == 1
  assert_eq '{Q(6, 4)}', '3/2'
  assert_eq '{Q(-1, 2)}', '-1/2'
  assert_eq '{Q(3)}', '3'
  assert_eq '{Q(0, 5)}', '0'

  # Errors: denominador zero i divisio per zero
  caught = try
    Q(1, 0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Q(1, 2) / 0
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Q(1, 2) / Q(0, 3)
  catch e
    'caught'
  assert_eq caught, 'caught'


@test poly_tests = ||
  write 'Testing Poly \t'

  # Construccio: coeficients de grau 0 amunt (coeffs[0] = terme independent)
  # ZZ per defecte, Q si hi ha fraccions
  p = Poly([6, -5, 1])          # x^2 - 5x + 6
  assert_eq p.degree(), NN(2)
  assert_eq p.coeffs(), [ZZ(6), ZZ(-5), ZZ(1)]

  q = Poly([3, Q(-5, 2), Q(1, 2)])   # 3 - (5/2)x + (1/2)x^2 = (1/2)(x-2)(x-3)
  assert_eq q.degree(), NN(2)
  assert_eq q.coeffs(), [Q(3), Q(-5, 2), Q(1, 2)]

  # Polinomi zero i grau
  assert_eq Poly([]).degree(), NN(0)
  assert_eq Poly([0, 0, 0]).degree(), NN(0)
  assert_eq Poly([7]).degree(), NN(0)

  # Suma / resta / multiplicacio (amb Poly i escalars)
  a = Poly([6, -5, 1])          # x^2 - 5x + 6
  b = Poly([1, 1])              # x + 1
  assert_eq a + b, Poly([7, -4, 1])
  assert_eq a - b, Poly([5, -6, 1])
  assert_eq a * b, Poly([6, 1, -4, 1])   # x^3 - 4x^2 + x + 6
  assert_eq a * 2, Poly([12, -10, 2])
  assert_eq 2 * a, Poly([12, -10, 2])
  assert_eq a * NN(2), Poly([12, -10, 2])
  assert_eq a * ZZ(2), Poly([12, -10, 2])
  assert_eq a * Q(1, 2), Poly([3, Q(-5, 2), Q(1, 2)])

  # Promocio ZZ -> Q en operacions mixtes
  mixed = Poly([Q(1, 2), 0, 1])  # x^2 + 1/2
  assert_eq mixed + a, Poly([Q(13, 2), Q(-5), Q(2)])
  assert_eq mixed * a, Poly([Q(3), Q(-5, 2), Q(13, 2), Q(-5), Q(1)])

  # eval (x pot ser Number/NN/ZZ/Q)
  assert_eq a.eval(2), ZZ(0)
  assert_eq a.eval(ZZ(3)), ZZ(0)
  assert_eq a.eval(Q(1, 2)), Q(15, 4)
  assert_eq a.eval(0.5), Q(15, 4)

  # derivative
  assert_eq a.derivative(), Poly([-5, 2])
  assert_eq Poly([5]).derivative(), Poly([])
  assert_eq Poly([1, 0, 0, 1]).derivative(), Poly([0, 0, 3])

  # gcd (monic; promou a Q si cal)
  assert_eq a.gcd(Poly([2, -3, 1])), Poly([-2, 1])
  assert_eq Poly([12, -10, 2]).gcd(Poly([2, -3, 1])), Poly([-2, 1])
  assert_eq Poly([Q(1, 2), 0, Q(1, 2)]).gcd(Poly([Q(1, 3), 0, Q(1, 3)])), Poly([1, 0, 1])

  # factor: x^2 - 5x + 6 -> (x-2)(x-3)
  f = a.factor()
  assert_eq f, [(Poly([-2, 1]), NN(1)), (Poly([-3, 1]), NN(1))]

  # factor sobre Q
  fq = q.factor()
  assert_eq fq, [(Poly([-2, 1]), NN(1)), (Poly([-3, 1]), NN(1))]

  # factor irreductible (sobre ZZ i sobre Q)
  fi = Poly([1, 0, 1]).factor()
  assert_eq fi, [(Poly([1, 0, 1]), NN(1))]
  fiq = Poly([Q(3, 2), Q(-5, 2), Q(1, 2)]).factor()
  assert_eq fiq, [(Poly([3, -5, 1]), NN(1))]

  # display: format estandard ascendent amb variable x
  assert_eq '{a}', '6 - 5x + x^2'
  assert_eq '{Poly([0])}', '0'
  assert_eq '{Poly([-1, 0, 1])}', '-1 + x^2'
  assert_eq '{Poly([1, 1])}', '1 + x'
  assert_eq '{Poly([3, 0, -2])}', '3 - 2x^2'
  assert_eq '{Poly([Q(1, 2), 0, 1])}', '(1/2) + x^2'
  assert_eq '{Poly([Q(-3, 2), Q(1, 2)])}', '-(3/2) + (1/2)x'

  # Errors: constructor sense llista i operacions amb tipus incorrectes
  caught = try
    Poly(1)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Poly([1, 2]) + 5
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Poly([1, 2]).eval('x')
  catch e
    'caught'
  assert_eq caught, 'caught'


@test mat_tests = ||
  write 'Testing Mat \t'

  # Construccio: matriu per files, auto ZZ si tots enters
  m = Mat([[1, 2], [3, 4]])
  assert_eq m.rows(), NN(2)
  assert_eq m.cols(), NN(2)
  assert_eq m.at(0, 0), ZZ(1)
  assert_eq m.at(0, 1), ZZ(2)
  assert_eq m.at(1, 0), ZZ(3)
  assert_eq m.at(1, 1), ZZ(4)
  assert_eq Mat([[1, 2], [3, 4]]), Mat([[1, 2], [3, 4]])

  # Amb fraccions -> Mat sobre Q
  mq = Mat([[Q(1, 2), Q(1, 2)], [Q(1, 3), Q(2, 3)]])
  assert_eq mq.rows(), NN(2)
  assert_eq mq.cols(), NN(2)
  assert_eq mq.at(0, 0), Q(1, 2)
  assert_eq mq.at(1, 1), Q(2, 3)

  # transpose
  assert_eq m.transpose(), Mat([[1, 3], [2, 4]])
  assert_eq m.transpose().transpose(), m

  # mul (metode i operador *)
  assert_eq m.mul(Mat([[5, 6], [7, 8]])), Mat([[19, 22], [43, 50]])
  assert_eq m * Mat([[5, 6], [7, 8]]), Mat([[19, 22], [43, 50]])

  # Suma / resta
  assert_eq m + Mat([[1, 1], [1, 1]]), Mat([[2, 3], [4, 5]])
  assert_eq m - Mat([[1, 1], [1, 1]]), Mat([[0, 1], [2, 3]])
  assert_eq m + mq, Mat([[Q(3, 2), Q(5, 2)], [Q(10, 3), Q(14, 3)]])

  # Multiplicacio per escalar
  assert_eq m * 2, Mat([[2, 4], [6, 8]])
  assert_eq m * Q(1, 2), Mat([[Q(1, 2), 1], [Q(3, 2), 2]])

  # det
  assert_eq m.det(), ZZ(-2)
  assert_eq mq.det(), Q(1, 6)
  assert_eq Mat([[1, 2, 3], [0, 1, 4], [5, 6, 0]]).det(), ZZ(1)

  # inverse (sobre Q; ZZ promociona a Q)
  inv = m.inverse()
  assert_eq inv, Mat([[-2, 1], [Q(3, 2), Q(-1, 2)]])
  assert_eq inv * m, Mat([[1, 0], [0, 1]])
  assert_eq mq.inverse() * mq, Mat([[1, 0], [0, 1]])

  # lll: reduccio LLL d'enters (novetat 0.0.16/0.0.17)
  # Exemple classic 2D: base {(1,1), (1,2)} -> base reduida {(-1,0), (0,1)}
  assert_eq Mat([[1, 1], [1, 2]]).lll(), Mat([[-1, 0], [0, 1]])
  assert_eq Mat([[1, 2], [3, 4]]).lll(), Mat([[1, 0], [0, 2]])
  # Exemple 3D
  assert_eq Mat([[1, 1, 0], [1, 0, 1]]).lll(), Mat([[1, 1, 0], [0, -1, 1]])

  # Display: files separades per , dins de [[...]] (format koto)
  assert_eq '{Mat([[1, 2], [3, 4]])}', '[[1, 2], [3, 4]]'
  assert_eq '{Mat([[Q(1, 2), 1], [3, 4]])}', '[[1/2, 1], [3, 4]]'

  # Errors
  caught = try
    Mat([[1, 2], [3]])
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    m.at(5, 0)
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Mat([[1, 2, 3], [4, 5, 6]]).det()
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    Mat([[1, 2], [2, 4]]).inverse()
  catch e
    'caught'
  assert_eq caught, 'caught'
  caught = try
    mq.lll()
  catch e
    'caught'
  assert_eq caught, 'caught'


@main = ||
  print 'Algebraeon Koto tests passed'
